{
  "expo": {
    "name": "Mis Gastos",
    "slug": "mis-gastos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.misgastos.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.misgastos.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F6FA",
          "dark": {
            "backgroundColor": "#0B0B12"
          },
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para proteger tus finanzas."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7C5CFF"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Permite elegir personas desde tus contactos."
        }
      ],
      "expo-status-bar"
    ],
    "scheme": "misgastos",
    "experiments": {
      "typedRoutes": true
    }
  }
}
