# Copia este archivo a .env (no lo subas al repo).

# ─── Servidor (docker compose de la web) ───────────────────────────────────
# Puerto del VPS donde escucha la web (ponle tu proxy con HTTPS delante)
WEB_PORT=8080
# Dónde está la API (proyecto mis-gastos-api). nginx reenvía /api ahí.
#   misma máquina → http://host.docker.internal:8081 · otro servidor → https://api.tu-dominio.com
API_UPSTREAM=http://host.docker.internal:8081

# ─── App (Expo) ────────────────────────────────────────────────────────────
# URL de la API. Si la dejas comentada, la app la calcula sola:
#   desarrollo → http://<IP de tu Mac>:8080/api · web en producción → /api (mismo dominio)
# Defínela para que la app en el celular apunte a tu API.
# EXPO_PUBLIC_API_URL=https://api.tu-dominio.com/api
